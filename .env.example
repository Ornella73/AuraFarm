# AuraFarm Environment Variables
AURAFARM_ENV=development
LOG_LEVEL=INFO

# Storage
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/aurafarm.db

# Safety & Freshness Rules
DATA_FRESHNESS_MAX_HOURS=48
STALE_DATA_DEFAULT_ALERT=ATTENDRE_CONSULTER_AGENT

# Weather & Climatology APIs (Open Access)
OPEN_METEO_API_URL=https://api.open-meteo.com/v1/forecast
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Telecom & Channels (Togo 2G Feature Phones)
DEFAULT_TELECOM_OPERATOR=yas_togo
USSD_SERVICE_CODE=*384*228#

# Voice IVR Provider (Twilio / Plivo / Mock)
VOICE_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_CALLER_ID=+22890000000

# Data Protection (Loi Togolaise 2019-014 - Anonymisation des numéros)
PHONE_HASH_SALT=aurafarm_togo_hackathon_2026_salt

